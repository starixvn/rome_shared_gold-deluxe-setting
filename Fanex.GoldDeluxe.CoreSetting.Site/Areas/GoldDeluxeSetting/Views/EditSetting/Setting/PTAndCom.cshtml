@model EditSettingViewModel
@{
    Layout = null;
}
<div id="tblPtComSetting" class="pt-container col-xs-12" data-ng-controller="PtAndComSettingController">
    <div class="pt-title">
        <span class="pt-title-text">@GoldDeluxeLang.lblPositionTakingCommission</span>
        <span data-ng-click="updatePtAndComSetting()" class="btn-save-partial" data-ng-if="!$parent.isReadOnly" title="@GoldDeluxeLang.lblUpdate"></span>
    </div>
    @if (Model.Setting.Commission != null && Model.Setting.PositionTaking != null)
    {
        switch (Model.Level)
        {
            case CustomerLevel.Super:
                <edit-super-pt-and-com></edit-super-pt-and-com>
                break;
            case CustomerLevel.Master:
            <edit-master-pt-and-com></edit-master-pt-and-com>
                break;
            case CustomerLevel.Agent:
            <edit-agent-pt-and-com></edit-agent-pt-and-com>
                break;
            case CustomerLevel.Member:
                switch (Model.UpLineLevel)
                {
                    case CustomerLevel.Super:
                        <super-edit-member-pt></super-edit-member-pt>
                        break;
                    case CustomerLevel.Master:
                    <master-edit-member-pt></master-edit-member-pt>
                        break;
                    default:
                    <agent-edit-member-pt-and-com></agent-edit-member-pt-and-com>
                        break;
                }
                break;
        }
    }
    else
    {
        <table class="pt-setting">
            <thead>
                <tr>
                    <th>
                        @GoldDeluxeLang.NoInformation
                    </th>
                </tr>
            </thead>
        </table>
    }

    <div id="presetOnMemberModal" class="modal fade">
        <div class="modal-dialog custom-modal-dialog">
            <div class="modal-content custom-modal-content">
                <div class="modal-header custom-modal-header">
                    <button type="button" class="close custom-close" data-dismiss="modal">
                        <span aria-hidden="true">&times;</span><span class="sr-only">Close</span>
                    </button>
                    <span class="modal-title custom-modal-title">
                        @if (GoldDeluxeSettings.Settings.System != SystemType.Agency)
                        {
                            @GoldDeluxeLang.lblConfirmUpdateMemberPT
                        }
                        else
                        {
                            @: &nbsp;
                        }
                    </span>
                </div>
                <div class="modal-body custom-modal-body">
                    <p>@(Model.Level == CustomerLevel.Master ? GoldDeluxeLang.lblHaveChangeMasterPositionTaking : GoldDeluxeLang.lblHaveChangeAgentPositionTaking)</p>
                    <p>@GoldDeluxeLang.lblChangePTTo:</p>
                    <select data-ng-model="uplinePTOnMember.newUplinePositionTaking"
                            data-ng-options="item.id as item.value for item in uplinePTOnMemberOptions"></select>
                </div>
                <div class="modal-footer custom-modal-footer">
                    <input type="button" class="custom-btn" data-ng-click="updatePTOnMember(true)" data-dismiss="modal" value="@GoldDeluxeLang.lblYes" />
                    <input type="button" class="custom-btn" data-ng-click="updatePTOnMember(false)" data-dismiss="modal" value="@GoldDeluxeLang.lblNo" />
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>
    <!-- /.modal -->
</div>
